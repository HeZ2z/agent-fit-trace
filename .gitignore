# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Desktop packaging output: electron-builder installers (`release/`) and the
# staged daemon bundle + App shell copy (`staging/`). Both are reproducible via
# `pnpm desktop:package`; CI uploads the installers as workflow artifacts instead
# of committing them. The desktop package also keeps a package-local .gitignore;
# these entries keep CI artifacts out of the tree even without it.
packages/fit-trace-desktop/release/
packages/fit-trace-desktop/staging/

# Test output
coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment
.env
.env.*
!.env.example

# Local orchestration state
.omx/

# Local package-manager and tool caches. pnpm's real store lives outside the
# repo (`pnpm store path` → ~/Library/pnpm/store/v10); a `.pnpm-store/` here is
# an orphan from a one-off invocation, never the configured store.
.pnpm-store/
.npm-cache/
**/.npm-cache/

# Local scratch/experiment directories that are not part of the product or the
# workspace package list.
prototypes/
sites/

# Local app data (workout store, durable coaching journal)
.pi/fit-trace/

# Editor / OS
.DS_Store
.idea/
.vscode/
.vercel/
supabase/.temp/
supabase/.branches/
.playwright-cli/
