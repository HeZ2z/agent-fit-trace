# Generated by `pnpm --filter @agent-fit-trace/desktop run build`:
# the esbuild daemon bundle, the staged copy of app/dist, and the provenance
# JSON files. Nothing here is source; it is rebuilt from the repo tree.
staging/

# electron-builder output: unpacked apps, dmg/zip/exe/AppImage installers,
# blockmaps and update metadata. Never committed (and never signed this round).
release/

# electron-builder's own downloads (Electron zips, nsis, 7z helpers), kept
# inside the workspace so CI can cache them without touching $HOME.
.cache/

# `electron-builder.yml` sets `directories.buildResources: build`, i.e. this
# package's `build/` holds committed SOURCE assets (app icons, entitlements),
# not generated output. The repo-root `build/` ignore rule is for generated
# Vite server output at the top level; this negation keeps a future
# `build/icon.png` from being silently un-trackable here.
!build/
