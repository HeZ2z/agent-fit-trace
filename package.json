{
  "name": "agent-fit-trace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "description": "A pi extension + skill that turns training logs into evidence-based progress analysis and draft training plans.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "pnpm run test:extension && pnpm run test:app",
    "test:extension": "node --disable-warning=ExperimentalWarning --test tests/*.test.ts",
    "test:app": "pnpm --filter app test",
    "dev:api": "node server/devApiServer.ts",
    "start": "node packages/fit-trace-cli/src/cli.ts start",
    "daemon": "node packages/fit-trace-cli/src/cli.ts daemon",
    "desktop:dev": "pnpm --filter @agent-fit-trace/desktop run dev",
    "coach:local": "node packages/fit-trace-cli/src/cli.ts start",
    "build": "pnpm build:server && pnpm --filter @agent-fit-trace/app build",
    "build:server": "pnpm --filter @agent-fit-trace/app exec vite build --config vite.server.config.ts",
    "typecheck": "tsc --noEmit && pnpm --filter app typecheck",
    "mobile:start": "pnpm --filter @agent-fit-trace/mobile start",
    "mobile:typecheck": "pnpm --filter @agent-fit-trace/mobile typecheck",
    "mobile:export:android": "pnpm --filter @agent-fit-trace/mobile export:android"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1"
  },
  "devDependencies": {
    "@agent-fit-trace/api-contracts": "workspace:*",
    "@agent-fit-trace/core": "workspace:*",
    "@agent-fit-trace/mcp": "workspace:*",
    "@agent-fit-trace/store": "workspace:*",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^24.0.0",
    "typebox": "^1.3.30",
    "typescript": "^5.9.0"
  }
}
