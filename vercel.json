{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "app/dist",
  "functions": {
    "api/**/*.mjs": { "includeFiles": "build/server/**" }
  },
  "rewrites": [
    {
      "source": "/api/v1/coaching/cloud/runs/:id/events",
      "destination": "/api/v1/coaching/cloud/runs/:id?__fit_trace_cloud_op=events"
    },
    {
      "source": "/api/v1/coaching/cloud/runs/:id/cancel",
      "destination": "/api/v1/coaching/cloud/runs/:id?__fit_trace_cloud_op=cancel"
    },
    { "source": "/((?!api(?:/|$)|assets(?:/|$)).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
