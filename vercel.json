{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "app/dist",
  "functions": {
    "api/**/*.mjs": { "includeFiles": "{build/server/**,.pi/skills/**}" }
  },
  "rewrites": [
    {
      "source": "/.well-known/oauth-protected-resource/api/mcp",
      "destination": "/api/mcp?__fit_trace_mcp_metadata=1"
    },
    {
      "source": "/api/v1/coaching/cloud/runs/:id/events",
      "destination": "/api/v1/coaching/cloud/runs/:id?__fit_trace_cloud_op=events"
    },
    {
      "source": "/api/v1/coaching/cloud/runs/:id/cancel",
      "destination": "/api/v1/coaching/cloud/runs/:id?__fit_trace_cloud_op=cancel"
    },
    { "source": "/api/v1/workouts", "destination": "/api/v1/router?__fit_trace_route=workouts" },
    { "source": "/api/v1/analysis", "destination": "/api/v1/router?__fit_trace_route=analysis" },
    { "source": "/api/v1/public-config", "destination": "/api/v1/router?__fit_trace_route=public-config" },
    { "source": "/api/v1/plans/drafts", "destination": "/api/v1/router?__fit_trace_route=plans/drafts" },
    { "source": "/api/v1/imports", "destination": "/api/v1/router?__fit_trace_route=imports" },
    { "source": "/api/v1/imports/:id", "destination": "/api/v1/router?__fit_trace_route=imports/:id" },
    { "source": "/api/v1/import-selections/:kind", "destination": "/api/v1/router?__fit_trace_route=import-selections/:kind" },
    { "source": "/api/v1/plan-adoption", "destination": "/api/v1/router?__fit_trace_route=plan-adoption" },
    { "source": "/((?!api(?:/|$)|assets(?:/|$)).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/.well-known/oauth-protected-resource/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
