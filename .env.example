# Fit-trace environment template (tracked; never commit secrets).
#
# Server vars (SUPABASE_*, FIT_TRACE_DEV_API_*) go in repo-root `.env.local`
# (run `node --env-file=.env.local ...` from the repo root).
# Vite `VITE_*` vars go in `app/.env.local` — Vite runs from `app/` and
# `app/vite.config.ts` sets no `envDir` override, so Vite does NOT read
# repo-root `.env.local`.
#
# Server (Vercel Functions + loopback dev API read these at runtime):
SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (anon key) — safe to expose to the browser via
# GET /api/v1/public-config. The app bootstraps login from the server;
# do NOT create NEXT_PUBLIC_* / VITE_* copies of secrets.
SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY=  # legacy alias; either key name works server-side.
# SUPABASE_SERVICE_ROLE_KEY=  # server-only if ever needed; NEVER expose to
# the browser and never commit. The workout API does NOT use it — user
# PostgREST requests carry the caller's own access token so RLS applies.

# Local dev API port (shared by server/devApiServer.ts and the Vite proxy):
FIT_TRACE_DEV_API_PORT=5199

# Local launcher (`pnpm coach:local`, packages/fit-trace-cli — source-run only,
# packaged npx distribution is deferred):
# Fixed authenticated data API base served by the launcher proxy (required).
# This is the Supabase-backed API (for example your deployed
# https://<app>.vercel.app/api/v1); the browser never chooses it.
FIT_TRACE_API_BASE_URL=
# Preferred launcher loopback port (default 5198); falls forward when busy.
FIT_TRACE_COACH_PORT=5198
# Built app directory served by the launcher (default <repo>/app/dist).
FIT_TRACE_APP_DIST=

# Local dev API mode (server/devApiServer.ts, FIT_TRACE_DEV_API_MODE):
# - memory (default when unset): unauthenticated loopback, in-memory store,
#   restart clears all records. Pair with the app's legacy opt-in below.
# - supabase: authenticated loopback backed by the local Supabase stack
#   (needs SUPABASE_URL + publishable key above); app runs in plain HTTP
#   mode WITHOUT the legacy flag.
# Node does NOT auto-read repo-root .env.local — pass it explicitly from the
# repo root, e.g.
# FIT_TRACE_DEV_API_MODE=supabase node --env-file=.env.local server/devApiServer.ts
# (the inline value wins over the file and any exported variable).
FIT_TRACE_DEV_API_MODE=

# Guest capabilities (server-side; GET /api/v1/public-config exposes only the
# resulting booleans). Default 0 = fail closed. Set to 1 only after validating
# against a local synthetic stack with the signup-gate migration and Auth
# profile active. FIT_TRACE_GUEST_UPGRADE=1 also requires manual linking and
# the same-UID upgrade trigger; it does not enable public signup.
FIT_TRACE_GUEST_SIGN_IN=0
FIT_TRACE_GUEST_UPGRADE=0
# If the deployment enforces CAPTCHA for anonymous sign-in, set this to 1.
# This app has no CAPTCHA widget, so guest entry fails closed (disabled)
# instead of sending a request that cannot pass. Never put a CAPTCHA/SMTP
# secret in this file or any VITE_* variable.
FIT_TRACE_GUEST_CAPTCHA_REQUIRED=0

# App transport: in a DEV build, unset (or anything but "http") selects
# browser localStorage but still requires public-config + a verified Supabase
# session. VITE_FIT_TRACE_MODE=http = same-origin /api/v1 (authenticated
# Supabase API or, with the legacy flag below, the memory loopback).
# Production requires an effective HTTP mode and fails closed before providers
# for missing/local/unknown/malformed runtime config. Put VITE_* vars in
# app/.env.local — Vite runs from app/ with no envDir override, so it does
# NOT read repo-root .env.local.
VITE_FIT_TRACE_MODE=

# Development/tests-only opt-in for the unauthenticated memory loopback UI
# (App.tsx isLegacyLoopbackAllowed): VITE_FIT_TRACE_MODE=http plus
# VITE_FIT_TRACE_LEGACY_LOOPBACK=1 bypasses the login gate against
# `pnpm dev:api`. Production builds always reject it — production HTTP stays
# gated on a validated session and fails closed without public-config.
# Never set this for the Supabase flow or any deployment.
VITE_FIT_TRACE_LEGACY_LOOPBACK=

# Set to 1 to run the real local-Supabase integration suite
# (tests/supabaseIntegration.test.ts) against the CLI+Docket stack above.
# Integration tests only run against loopback URLs and never touch cloud.
FIT_TRACE_SUPABASE_INTEGRATION=

# Default pi agent via OpenRouter — PLANNED, NOT IMPLEMENTED in this slice.
# Leave blank until the coaching milestone configures a runtime. A missing
# configuration must surface an "unconfigured agent" state and never silently
# use a paid model; workout tracking and deterministic analysis keep working.
FIT_TRACE_OPENROUTER_BASE_URL=
FIT_TRACE_OPENROUTER_API_KEY=
FIT_TRACE_OPENROUTER_MODEL=
